{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "ticket_tracker",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "autoupdate": false,
  "lsp": {
    "csharp": {
      "disabled": true
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "mempalace": {
      "type": "local",
      "command": ["mempalace-mcp"]
    }
  }
}
