{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "autoupdate": false,
  "skills": [
    "~/.nix-profile/share/mempalace/skills",
    "~/.nix-profile/share/archify/skills"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "mempalace": {
        "type": "local",
        "command": ["mempalace-mcp"]
      }
    }
  }
}
