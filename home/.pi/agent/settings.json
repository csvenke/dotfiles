{
  "theme": "system",
  "defaultProvider": "github-copilot",
  "defaultModel": "kimi-k3",
  "defaultThinkingLevel": "high",
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "lastChangelogVersion": "1.0.3",
  "enableSkillCommands": false,
  "showCacheMissNotices": true,
  "treeFilterMode": "user-only",
  "defaultTools": ["+codemode"],
  "skills": [
    "~/.nix-profile/share/mempalace/skills",
    "~/.nix-profile/share/archify/skills"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": { "model": "github-copilot/gpt-5.6-luna", "thinking": "low" },
      "scout": { "model": "github-copilot/gpt-5.6-luna", "thinking": "low" }
    }
  }
}
