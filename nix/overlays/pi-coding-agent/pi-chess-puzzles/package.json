    "test:e2e": "bash test/e2e.sh"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
