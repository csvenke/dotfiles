{
  "name": "pi-chess-puzzles",
  "version": "0.1.0",
  "private": true,
  "description": "Solve lichess chess puzzles in an overlay while pi agents work",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
